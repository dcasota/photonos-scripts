diff --git a/SPECS/photon-os-installer/0005-tdnf-capture-install-output.patch b/SPECS/photon-os-installer/0005-tdnf-capture-install-output.patch
new file mode 100644
index 000000000..e921dffa4
--- /dev/null
+++ b/SPECS/photon-os-installer/0005-tdnf-capture-install-output.patch
@@ -0,0 +1,44 @@
+From 43ea3a467cfc4c4abb2690e17fe3ab5e619f19cf Mon Sep 17 00:00:00 2001
+From: Daniel Casota <dcasota@gmail.com>
+Date: Thu, 4 Jun 2026 22:05:37 +0200
+Subject: [PATCH] tdnf: capture install output so it doesn't overlay the curses
+ UI
+
+execute(do_json=False) used subprocess.check_call(), inheriting the
+installer's stdout/stderr. During a UI install that overlays the curses
+progress bar with tdnf/rpm messages (e.g. file paths like /etc/os-release).
+Capture the output and send it to the log instead.
+
+Co-Authored-By: Daniel Casota <dcasota@gmail.com>
+---
+ photon_installer/tdnf.py | 14 +++++++++++++-
+ 1 file changed, 13 insertions(+), 1 deletion(-)
+
+diff --git a/photon_installer/tdnf.py b/photon_installer/tdnf.py
+index 8d98b8e..567dd61 100644
+--- a/photon_installer/tdnf.py
++++ b/photon_installer/tdnf.py
+@@ -177,7 +177,19 @@ class Tdnf:
+ 
+             return retval, out_json
+         else:
+-            return subprocess.check_call(args)
++            # Capture output and route it to the log instead of inheriting the
++            # parent's stdout/stderr. During a UI (curses) install the latter
++            # overlays the progress bar with tdnf/rpm messages such as file
++            # paths (e.g. /etc/os-release).
++            process = subprocess.Popen(
++                args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
++            )
++            for line in process.stdout:
++                self.logger.info(line.decode('utf-8', errors='replace').rstrip())
++            retval = process.wait()
++            if retval != 0:
++                raise subprocess.CalledProcessError(retval, args)
++            return retval
+ 
+     def run(self, args=None, do_json=True):
+         # Fix mutable default arguments issue
+-- 
+2.43.7
+
diff --git a/SPECS/photon-os-installer/0006-stig-drop-redundant-packages.patch b/SPECS/photon-os-installer/0006-stig-drop-redundant-packages.patch
new file mode 100644
index 000000000..58eff7fed
--- /dev/null
+++ b/SPECS/photon-os-installer/0006-stig-drop-redundant-packages.patch
@@ -0,0 +1,56 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Daniel Casota <dcasota@gmail.com>
+Date: Mon, 31 Aug 2026 03:10:00 +0200
+Subject: [PATCH] stigenable: drop three packages the hardening does not need
+
+Each added package is attack surface on a system whose purpose is to be
+hardened, so KS_STIG_PACKAGES should name only what the role actually uses.
+Three entries do not:
+
+libselinux-utils - the role never invokes any of its binaries (getenforce,
+setenforce, sestatus, restorecon, fixfiles); a grep over every *.yml in
+stig-hardening finds no reference. It is also already a Requires of
+selinux-policy, so it is installed either way and listing it changes nothing.
+The relabel service calls /usr/sbin/restorecon, which comes from
+policycoreutils, not from this package.
+
+ntp - installed and then never configured. handlers/main.yml defines
+"restart ntpd", "restart chrony" and "restart timesyncd", but no task
+notifies any of them, and outside handlers/main.yml the string "ntp" does not
+occur anywhere in the role: no ntp.conf/chrony.conf/timesyncd.conf task, no
+server or pool setting, and no PHTN control for time synchronisation among
+the 117 in the role. (README.md documents a var_ntp_servers extra-var that
+nothing consumes.) Photon 5.0 also has no package named ntp; it resolves to
+ntpsec via Provides. Removing it leaves a daemon uninstalled rather than
+installed-and-ignored.
+
+libgcrypt - present only to work around a packaging bug, as the role itself
+records at tasks/photon.yml: "Currently a bug in the aide package that does
+not upgrade libgcrypt to the needed version". The fix belongs in aide.spec,
+which now carries a versioned Requires, so the workaround is unnecessary.
+
+Time synchronisation being unimplemented is a separate finding and is not
+addressed here; this change only stops installing a package for it.
+
+Co-Authored-By: Daniel Casota <dcasota@gmail.com>
+---
+ photon_installer/stigenable.py | 3 ---
+ 1 file changed, 3 deletions(-)
+
+diff --git a/photon_installer/stigenable.py b/photon_installer/stigenable.py
+--- a/photon_installer/stigenable.py
++++ b/photon_installer/stigenable.py
+@@ -23,10 +23,7 @@
+     "rsyslog",
+     "openssl-fips-provider",
+     "selinux-policy",
+-    "libselinux-utils",
+-    "ntp",
+-    "aide",
+-    "libgcrypt"
++    "aide"
+ ]
+ 
+ 
+-- 
+2.51.0
diff --git a/SPECS/photon-os-installer/0007-installer-seed-locale.conf-before-package-install.patch b/SPECS/photon-os-installer/0007-installer-seed-locale.conf-before-package-install.patch
new file mode 100644
index 000000000..a27e179ec
--- /dev/null
+++ b/SPECS/photon-os-installer/0007-installer-seed-locale.conf-before-package-install.patch
@@ -0,0 +1,57 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Daniel Casota <dcasota@gmail.com>
+Date: Mon, 31 Aug 2026 00:00:00 +0000
+Subject: [PATCH] installer: seed /etc/locale.conf before package install
+
+The initramfs rpm ships a %transfiletriggerin that runs
+"mkinitrd -q /boot/initrd.img-$kver $kver" at the end of the package
+transaction performed by _install_packages(). dracut's 20i18n module
+checks for $I18N_CONF (/etc/locale.conf) and, when it is missing and
+i18n_vars is unset, reports
+
+  dracut[E]: i18n_vars not set!  Please set up i18n_vars in  configuration file.
+
+on the installer console right before the ansible run, and then falls
+back to install_all_kbd() - embedding every keymap in the initrd instead
+of the target's own.
+
+/etc/locale.conf is only created by m_locale, which runs in the
+POST_INSTALL phase, twelve steps after _install_packages(). The file is
+therefore guaranteed to be absent while the initrd is generated.
+
+Seed it in _initialize_system(), directly after the filesystem rpm that
+provides /etc is installed and before any package transaction can fire
+the trigger. m_locale is left untouched: it rewrites the same content
+and runs localedef, and it still covers the ostree install path where
+_initialize_system() is not called.
+
+Signed-off-by: Daniel Casota <dcasota@gmail.com>
+---
+ photon_installer/installer.py | 14 ++++++++++++++
+ 1 file changed, 14 insertions(+)
+
+--- a/photon_installer/installer.py
++++ b/photon_installer/installer.py
+@@ -1300,6 +1300,20 @@
+             self.logger.error("Failed to install filesystem rpm")
+             self.exit_gracefully()
+ 
++        # dracut's 20i18n module reads /etc/locale.conf when it builds an
++        # initrd. The initramfs rpm installs a file trigger that runs mkinitrd
++        # at the end of the package transaction started by _install_packages()
++        # below - long before m_locale (POST_INSTALL) creates the file. Without
++        # it dracut aborts i18n setup with
++        #   "i18n_vars not set!  Please set up i18n_vars in  configuration file."
++        # and falls back to embedding every keymap. Seed the file here so the
++        # initrd is built with the target's locale; m_locale writes the same
++        # content again later and additionally runs localedef.
++        locale_conf_path = os.path.join(self.photon_root, "etc/locale.conf")
++        os.makedirs(os.path.dirname(locale_conf_path), exist_ok=True)
++        with open(locale_conf_path, "w") as locale_conf:
++            locale_conf.write("LANG=en_US.UTF-8\n")
++
+     def _mount_special_folders(self):
+         for d in ["/proc", "/dev", "/dev/pts", "/sys"]:
+             self._mount(d, d, bind=True, create=True)
+-- 
+2.43.7
