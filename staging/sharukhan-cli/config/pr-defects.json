{
  "prs": [
    {
      "pr": 22,
      "package": "systemd",
      "title": "systemd: render and systemd-journal groups, STIG variant",
      "subreleases": {
        "from": 91
      },
      "defects": [
        {
          "id": "render-rule",
          "summary": "`accel` udev rule refers to the removed `render` group",
          "symptom_check": "guest.no_render_group",
          "probes": [
            {
              "kind": "file",
              "file": "0004-Remove-unused-default-groups-rules-and-tmpfiles.patch",
              "present_if_all": [
                {
                  "line": " SUBSYSTEM==\"accel\", GROUP=\"render\", MODE=\"{{GROUP_RENDER_MODE}}\""
                },
                {
                  "prefix": "-g render "
                }
              ]
            }
          ]
        },
        {
          "id": "journal-snippet",
          "summary": "`systemd-journal` sysusers snippet emptied (initrd has no group)",
          "symptom_check": "guest.no_journal_group",
          "probes": [
            {
              "kind": "file",
              "file": "0004-Remove-unused-default-groups-rules-and-tmpfiles.patch",
              "present_if_all": [
                {
                  "line": "-g systemd-journal {{SYSTEMD_JOURNAL_GID}} -"
                }
              ]
            }
          ]
        },
        {
          "id": "journal-gid",
          "summary": "journal GID not pinned to filesystem's 23 (needed with the snippet)",
          "probes": [
            {
              "kind": "file",
              "file": "systemd.spec",
              "present_if_none": [
                {
                  "contains": "-Dsystemd-journal-gid="
                }
              ]
            }
          ]
        },
        {
          "id": "stig-define",
          "summary": "`%define STIG_HARDEN 0` cannot be overridden with `-D`",
          "probes": [
            {
              "kind": "file",
              "file": "systemd.spec",
              "applies_if": [
                {
                  "contains": "STIG_HARDEN"
                }
              ],
              "present_if_all": [
                {
                  "line": "%define STIG_HARDEN 0"
                }
              ]
            }
          ]
        },
        {
          "id": "stig-prep",
          "summary": "STIG variant: `harden-tmpfs-mount-options.patch` missing from `%prep` or not applying",
          "symptom_check": "guest.tmp_noexec",
          "probes": [
            {
              "kind": "series",
              "defines": {
                "STIG_HARDEN": "1"
              },
              "applies_if": [
                {
                  "contains": "STIG_HARDEN"
                }
              ],
              "expect_patch": "harden-tmpfs-mount-options.patch"
            }
          ]
        }
      ]
    },
    {
      "pr": 79,
      "package": "systemd",
      "title": "systemd: ship each file of systemd-container and systemd-journal-remote once",
      "subreleases": {
        "from": 91
      },
      "defects": [
        {
          "id": "journal-remote-overlap",
          "summary": "main package also owns systemd-journal-remote's binaries and units",
          "probes": [
            {
              "kind": "file",
              "file": "systemd.spec",
              "present_if_all": [
                {
                  "line": "%{_unitdir}/*"
                }
              ],
              "present_if_none": [
                {
                  "line": "%exclude %{_unitdir}/%{name}-journal-remote.service"
                }
              ]
            },
            {
              "kind": "rpm-overlap",
              "packages": [
                "systemd",
                "systemd-journal-remote"
              ]
            }
          ]
        },
        {
          "id": "container-overlap",
          "summary": "main package and systemd-container both own nspawn@ and machined files",
          "probes": [
            {
              "kind": "file",
              "file": "systemd.spec",
              "present_if_all": [
                {
                  "line": "%{_unitdir}/*"
                }
              ],
              "present_if_none": [
                {
                  "line": "%exclude %{_unitdir}/%{name}-nspawn@.service"
                }
              ]
            },
            {
              "kind": "rpm-overlap",
              "packages": [
                "systemd",
                "systemd-container"
              ]
            }
          ]
        },
        {
          "id": "journal-remote-scriptlets",
          "summary": "systemd-journal-remote has no unit scriptlets",
          "probes": [
            {
              "kind": "file",
              "file": "systemd.spec",
              "applies_if": [
                {
                  "prefix": "%files journal-remote"
                }
              ],
              "present_if_none": [
                {
                  "prefix": "%post journal-remote"
                }
              ]
            }
          ]
        }
      ]
    },
    {
